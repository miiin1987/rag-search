# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# fonts (大容量のため除外。scripts/fonts/README.md に取得方法を記載)
scripts/fonts/*.ttf
scripts/fonts/*.otf
scripts/fonts/*.woff
scripts/fonts/*.woff2

# 生成されたテストPDF（npm run generate-pdfs で再生成可能）
test-pdfs/
scripts/test-japanese.pdf

.vercel
.env*
