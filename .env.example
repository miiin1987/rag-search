# ============================================================
# 環境変数テンプレート
# このファイルをコピーして .env.local を作成し、各値を設定してください。
#   cp .env.example .env.local
# ============================================================

# OpenAI
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Supabase
# Supabase ダッシュボード → Settings → API から取得
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 管理画面パスワード（任意の文字列を設定してください）
ADMIN_SECRET=your-admin-password-here

# Upstash Redis（レート制限）
# セットアップ: https://console.upstash.com/ → Redis → Create Database (us-east-1)
# 未設定の場合はプロセスメモリにフォールバック（Vercel 本番環境では設定を推奨）
UPSTASH_REDIS_REST_URL=https://your-redis-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=
